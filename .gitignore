01_sources/**/*.doc
01_sources/**/*.docx
01_sources/**/*.dwg
01_sources/**/*.dxf
01_sources/**/*.html
01_sources/**/*.htm
01_sources/**/*_files/**

# Generated exports and backups (keep directory placeholders)
10_exports/*
!10_exports/.gitkeep
11_backups/*
!11_backups/.gitkeep

